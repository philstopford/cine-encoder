# Build with makepkg from a source archive of this repository.
pkgname=cine-encoder
pkgver=3.5.5
pkgrel=1
pkgdesc="Cine Encoder media converter"
arch=('x86_64')
url="https://github.com/philstopford/cine-encoder"
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-svg' 'qt6-multimedia' 'libmediainfo' 'ffmpeg' 'mkvtoolnix-cli')
makedepends=('cmake' 'gcc')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "${srcdir}/${pkgname}-${pkgver}" -B "${srcdir}/build" \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF
  cmake --build "${srcdir}/build" --parallel
}

package() {
  DESTDIR="${pkgdir}" cmake --install "${srcdir}/build"
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/share/cine-encoder.desktop" "${pkgdir}/usr/share/applications/cine-encoder.desktop"
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/share/cine-encoder.png" "${pkgdir}/usr/share/icons/hicolor/64x64/apps/cine-encoder.png"
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/share/cine-encoder.wav" "${pkgdir}/usr/share/sounds/cine-encoder.wav"
}
